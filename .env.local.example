# ─────────────────────────────────────────────────────────────────────
# Cool-Chain Copilot — env template
# Copy to `.env.local` and fill real values. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────

# ─── Demo mode ───────────────────────────────────────────────────────
# Gates /dev/control + /dev/inject routes. Set "true" in dev/staging,
# leave unset (or "false") in production.
NEXT_PUBLIC_DEMO_MODE=true

# Scenario runner cadence. A 1000ms tick means 1x speed advances one
# scenario second per real second; 2x advances two scenario seconds, etc.
NEXT_PUBLIC_SIMULATION_TICK_MS=1000

# Tracker feed logical cadence. Default emits one synthetic tracker sample
# every 10 logical minutes.
NEXT_PUBLIC_TRACKER_LOGICAL_CADENCE_MS=600000


# ─── DG AutoCheck Connect API (v1) ───────────────────────────────────
# Spec: dg-autocheck-api/integration.md
# When DG_AUTOCHECK_ENABLED is "true", build-up canvas calls real API.
# When unset or "false", uses stub mode (fixture-based, demo-safe).

# Toggle real-mode integration. Stub mode is the demo default.
DG_AUTOCHECK_ENABLED=false

# Subscription-specific base URL — same value as Postman {{domain}}.
# Example: https://your-tenant.dgautocheck.com
DG_AUTOCHECK_BASE_URL=

# OAuth 2.0 client credentials from the DG AutoCheck Web Services portal.
# Permissions required: List, Read, Manage (API Integrator license).
DG_AUTOCHECK_CLIENT_ID=
DG_AUTOCHECK_CLIENT_SECRET=

# Webhook signature verification token. Shown ONCE when the webhook is
# created in the portal. Same value across every webhook on the account;
# never rotates automatically. Used as `sha256(token + rawBody)`.
DG_AUTOCHECK_VERIFICATION_TOKEN=

# Office identifier — CMS-owned, immutable, case-sensitive. Created on
# first use if unknown. We use a stable id for our DXB warehouse.
DG_AUTOCHECK_OFFICE_IDENTIFIER=DXB-WAREHOUSE-01

# Optional user identifier — passed on request-url calls. If omitted,
# every action attributes to the API integrator user (no per-user
# audit trail). Recommended to set per-operator-session in real ops.
# DG_AUTOCHECK_USER_IDENTIFIER=


# ─── One Connect / 1Neo-Connect ONE Record API ───────────────────────
# Live ULD telemetry + Waybill stream integration. Keep disabled for the
# deterministic demo unless a hackathon sandbox is reachable.
ONE_CONNECT_ENABLED=false
ONE_CONNECT_CLIENT_ID=
ONE_CONNECT_CLIENT_SECRET=
ONE_CONNECT_IDP_URL=
ONE_CONNECT_API_URL=
ONE_CONNECT_PROXY_URL=
ONE_CONNECT_TAXON_API_URL=

# Poll cadence for cached One Connect notifications when webhooks are not
# available in local/dev deployments.
ONE_CONNECT_NOTIFICATION_POLL_MS=5000

# Per-ULD fallback to synthetic feed when no live Measurement received within this window
ONE_CONNECT_STALE_MS=30000
